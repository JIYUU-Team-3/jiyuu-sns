# Cloudflare D1
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# Email and password accounts, for the e2e server only (.env.e2e sets it). Leave empty.
ALLOW_EMAIL_SIGNUP=""
# Optional local login bypass. Only Vite development on loopback HTTP accepts `1`.
DEV_AUTH_BYPASS=""

# Google OAuth
# https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Push notifications (optional; empty turns push off)
# Generate a key pair with `pnpm push:keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Automatic moderation checks with Workers AI (optional; empty turns them off).
# Every call counts against the account's free 10,000 neurons a day, shared with production.
WORKERS_AI_ACCOUNT_ID=""
WORKERS_AI_TOKEN=""

# Translating posts between English and Japanese (optional; empty uses Workers AI instead).
# https://www.deepl.com/pro-api
DEEPL_API_KEY=""

# GIF picker
# https://developers.giphy.com/
GIPHY_API_KEY=""
