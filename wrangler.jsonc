{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "jiyuu-sns",
	"compatibility_date": "2026-09-16",
	"compatibility_flags": ["nodejs_als"],
	// Written by the Cloudflare adapter, then wrapped by scripts/wrap-worker.js to add the hourly
	// Cron Trigger below, which the adapter has no hook for.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	// `src/hooks.server.ts` requires this binding and throws without it, so every
	// request 500s if it is missing. `database_id` is the same database that
	// `drizzle.config.ts` migrates via CLOUDFLARE_DATABASE_ID; it is an account
	// -scoped identifier, not a secret, and belongs in version control.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sns-db",
			"database_id": "e7da79ec-501a-4177-a829-55f1afd5b129",
			// drizzle-kit writes its migrations here; `wrangler d1 migrations apply`
			// reads the same directory and ignores the meta/ subfolder.
			"migrations_dir": "drizzle",
		},
	],
	// Bound to the existing `sns_kv` namespace. Reachable at runtime as `env.KV`
	// via `cloudflare:workers`, same as the D1 binding above; `wrangler types`
	// picks it up automatically.
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "9fccb61c440845498d309ba3bd7098b8",
		},
	],
	// Uploaded avatars and banners, served by `src/routes/media/[...key]`. Local dev
	// emulates the bucket; deploys need it created once with
	// `wrangler r2 bucket create jiyuu-media`.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "jiyuu-media",
		},
	],
	// Makes the small copy of a large photo that the automatic checks send to the vision model;
	// see `shrink` in `src/lib/server/moderation/checks.ts`. Local dev runs an offline version.
	"images": { "binding": "IMAGES" },
	// Rate limiters, counted per account id (or per address for AUTH_LIMIT) at each Cloudflare
	// location; see `src/lib/server/rate-limit.ts`. `namespace_id` is any number unique to this
	// account, and `period` is in seconds.
	"ratelimits": [
		// Posting, liking, following, voting: more than a person does in a minute.
		{ "name": "WRITE_LIMIT", "namespace_id": "1701", "simple": { "limit": 60, "period": 60 } },
		// Sending and reacting in a chat, which goes faster than posting.
		{ "name": "MESSAGE_LIMIT", "namespace_id": "1705", "simple": { "limit": 120, "period": 60 } },
		// Photos and videos. A full thread of photos is 60; nobody posts two a minute.
		{ "name": "UPLOAD_LIMIT", "namespace_id": "1702", "simple": { "limit": 90, "period": 60 } },
		// Search-as-you-type and the GIF and place pickers.
		{ "name": "LOOKUP_LIMIT", "namespace_id": "1703", "simple": { "limit": 240, "period": 60 } },
		// Better Auth's endpoints and starting a Google sign-in, per address.
		{ "name": "AUTH_LIMIT", "namespace_id": "1704", "simple": { "limit": 30, "period": 60 } },
		// Moderator actions: a fast moderator clears a few items a minute, a script far more.
		{ "name": "MOD_LIMIT", "namespace_id": "1706", "simple": { "limit": 120, "period": 60 } },
		// Posts and messages with links: each one asks Cloudflare's security resolver about them.
		{
			"name": "LINK_LOOKUP_LIMIT",
			"namespace_id": "1707",
			"simple": { "limit": 30, "period": 60 },
		},
		// The composer asking whether a photo it just uploaded is sensitive: once per upload.
		{
			"name": "MEDIA_CHECK_LIMIT",
			"namespace_id": "1708",
			"simple": { "limit": 90, "period": 60 },
		},
	],
	// The hourly moderation job (scripts/wrap-worker.js). The Free plan allows 5 per account.
	"triggers": { "crons": ["17 * * * *"] },
	"workers_dev": true,
	// Preview versions would run with the production database and secrets on a second URL.
	"preview_urls": false,
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 0.1,
			"invocation_logs": true,
			"persist": true,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1,
			"persist": true,
		},
	},
}
