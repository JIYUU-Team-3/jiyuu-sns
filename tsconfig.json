{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		// SvelteKit defaults checkJs to true, which drags every generated .js file
		// into the type program — including the compiled bundle under .svelte-kit,
		// reached via GlobalProps.mainModule in worker-configuration.d.ts. This
		// project has no hand-written .js, so nothing of ours goes unchecked.
		"checkJs": false,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		// The package.json "imports" map resolves #lib/* at runtime, but TypeScript
		// does not infer extensions or /index for "imports" targets, so #lib/server/db
		// and friends come back unresolved. "paths" does infer both. Keep the two in
		// sync; the imports map stays authoritative for Vite and Node.
		"paths": { "#lib/*": ["./src/lib/*"] },
		"types": ["$app/types", "./worker-configuration.d.ts"]
	},
	"include": ["src", "drizzle.config.ts"]
}
