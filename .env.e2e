# Loaded after .env by `pnpm preview:ci`, the server the e2e tests run against.
# Not named .env.test on purpose: Vite loads that in test mode, and vitest would then write
# this ORIGIN into the generated env a running `pnpm dev` reads.
# Better Auth only answers requests on its base URL, so it must match that server.
ORIGIN="http://127.0.0.1:4173"
