# Loaded after .env by `pnpm preview:ci`, the server the e2e tests run against.
# Not named .env.test on purpose: Vite loads that in test mode, and vitest would then write
# this ORIGIN into the generated env a running `pnpm dev` reads.
# Better Auth only answers requests on its base URL, so it must match that server.
ORIGIN="http://127.0.0.1:4173"
# The tests sign up with an email and a password; nowhere else allows that.
ALLOW_EMAIL_SIGNUP="1"
# Nothing here signs in with Google, but Better Auth warns on every request when the provider
# has no credentials. Placeholders keep the test log readable; they reach no real Google client.
GOOGLE_CLIENT_ID="e2e-placeholder"
GOOGLE_CLIENT_SECRET="e2e-placeholder"
BETTER_AUTH_SECRET="e2e-only-placeholder-secret-not-for-real-use"
